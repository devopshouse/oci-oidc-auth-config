# Copy this file to terraform.tfvars and fill in your values.
# Run: cp terraform.tfvars.example terraform.tfvars

oci_region         = "<YOUR_OCI_REGION>"        # e.g. sa-saopaulo-1
oci_tenancy_id     = "<YOUR_TENANCY_OCID>"      # ocid1.tenancy.oc1..aaa...
oci_compartment_id = "<YOUR_COMPARTMENT_OCID>"  # ocid1.compartment.oc1..aaa...

# GitHub organisation or user (required when ci_platforms includes "github")
github_owner = "<YOUR_GITHUB_ORG>"              # e.g. my-org

ci_platforms = ["github"]

github = {
  branch = "main"
  repositories = [
    { path = "<YOUR_ORG>/<YOUR_REPO>" },        # e.g. my-org/my-repo
    # per-repo branch override (optional):
    # { path = "<YOUR_ORG>/hotfix-service", ref = "hotfix" },
  ]
  create_secrets = true   # writes OCI_OIDC_CONFIG to each repo automatically
}

# Optional — override defaults if needed
# oci_profile              = "DEFAULT"
# oci_identity_domain_name = "Default"
# oci_service_user_name    = "svc-ci-oidc"
# git_actions_group_name   = "g-ci-oidc"
# ocir_allowed_repositories = []  # empty = broad push/pull in compartment

# GitLab CI OIDC federation (add "gitlab" to ci_platforms to enable)
# ci_platforms = ["github", "gitlab"]
#
# gitlab = {
#   issuer   = "https://gitlab.com"             # override for self-managed GitLab
#   audience = "https://cloud.oracle.com"
#   ref      = "main"                           # global default ref
#   ref_type = "branch"                         # global default ref_type
#   projects = [
#     { path = "<YOUR_GROUP>/<YOUR_PROJECT>" },                          # uses global ref/ref_type
#     { path = "<YOUR_GROUP>/app", ref_type = "branch", ref = "main" }, # exact branch
#     # ref="*" → matched via project_path claim (any tag or branch accepted):
#     { path = "<YOUR_GROUP>/release-svc", ref_type = "tag", ref = "*" },
#   ]
# }
