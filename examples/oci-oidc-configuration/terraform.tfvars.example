# Copy this file to terraform.tfvars and fill in your values.
# Run: cp terraform.tfvars.example terraform.tfvars

oci_region         = "<YOUR_OCI_REGION>"        # e.g. sa-saopaulo-1
oci_tenancy_id     = "<YOUR_TENANCY_OCID>"      # ocid1.tenancy.oc1..aaa...
oci_compartment_id = "<YOUR_COMPARTMENT_OCID>"  # ocid1.compartment.oc1..aaa...

# Existing Identity Domain that receives the CI identities.
# oci_identity_domain_name = "Default"

github_owner        = "<YOUR_GITHUB_ORG>"       # e.g. my-org
github_repositories = ["<YOUR_ORG>/<YOUR_REPO>"]
# github_refs       = ["refs/heads/main"]       # ["*"] accepts any ref
# github_organizations  = ["<YOUR_GITHUB_ORG>"]   # every repository; organization secret when equal to github_owner
# github_create_secrets = true                   # false: trust only, no secret

ci_platforms = ["github"]

# GitLab CI OIDC federation (add "gitlab" to ci_platforms to enable)
# ci_platforms = ["github", "gitlab"]
#
# gitlab_oidc = {
#   issuer   = "https://gitlab.com"             # override for self-managed GitLab
#   audience = "https://cloud.oracle.com"
# }
#
# gitlab_project_refs = [
#   { path = "<YOUR_GROUP>/<YOUR_PROJECT>" },                          # main, branch
#   { path = "<YOUR_GROUP>/release-svc", ref_type = "tag", ref = "*" }, # any tag
# ]
